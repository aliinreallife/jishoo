# Supply your own server-only development database and random encryption key.
DATABASE_URL=
APP_SECRET=
TESTING_MODE=true
# Phone login/linking is paused. Never use demo SMS as account ownership proof.
PHONE_AUTH_ENABLED=false
INVITE_ONLY=true
# Set to a UTC ISO timestamp exactly seven days after the launch deployment.
# Before this deadline public registration works; afterward invites are required.
OPEN_SIGNUP_UNTIL=
# Server-only public campaign code, generated out of band. 92 accounts / 30 days.
LAUNCH_PROMO_CODE=
PUBLIC_APP_URL=http://localhost:4173
# Shareable initial invitation, not a login credential.
BOOTSTRAP_INVITE_CODE=JISHOO-LOCAL-INVITE
# Optional browser push: generate a VAPID pair with the web-push package.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Server-only random bearer secret for Vercel's daily reminder cron.
# Keep empty locally unless testing the protected scheduler endpoint.
CRON_SECRET=
# Owner-only secondary login. Store salt:scrypt-64-byte-hex, never the password.
# scripts/configure_admin_password.py installs the hash via authorized Vercel access.
ADMIN_PASSWORD_HASH=

# Google OAuth: server only. Authorize PUBLIC_APP_URL/api/auth/google in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional CARTO basemap access key; visible in public browser tile requests.
CARTO_KEY=
# Android TWA release signing fingerprints, comma-separated SHA-256 values.
ANDROID_PACKAGE_ID=app.jishoo.twa
ANDROID_SHA256_CERTIFICATES=

# Enable in Vercel's project dashboard first, then set true and redeploy.
# Keep false while quotas/features are unavailable. No scripts load while off.
VITE_VERCEL_ANALYTICS_ENABLED=false
VITE_VERCEL_SPEED_INSIGHTS_ENABLED=false
