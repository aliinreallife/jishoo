# Supply your own server-only development database and random encryption key.
DATABASE_URL=
APP_SECRET=
TESTING_MODE=true
INVITE_ONLY=true
PUBLIC_APP_URL=http://localhost:4173
# Shareable initial invitation, not a login credential.
BOOTSTRAP_INVITE_CODE=JISHOO-LOCAL-INVITE
# Optional browser push: generate a VAPID pair with the web-push package.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Owner-only secondary login. Store salt:scrypt-64-byte-hex, never the password.
# scripts/configure_admin_password.py installs the hash via authorized Vercel access.
ADMIN_PASSWORD_HASH=

# Google OAuth: server only. Authorize PUBLIC_APP_URL/api/auth/google in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional CARTO basemap access key; visible in public browser tile requests.
CARTO_KEY=
# Android TWA release signing fingerprints, comma-separated SHA-256 values.
ANDROID_PACKAGE_ID=app.jishoo.twa
ANDROID_SHA256_CERTIFICATES=
